# GoPay 配置文件
# 将此文件复制为 gopay.env 并修改配置值
# 优先级：命令行参数 > 配置文件 > 默认值

# 数据库连接字符串（PostgreSQL 或 SQLite）
# PostgreSQL: host=127.0.0.1 port=5432 user=gopay password=your_password dbname=gopay sslmode=disable
# SQLite: /path/to/gopay.db
DB=host=127.0.0.1 port=5432 user=gopay password=your_password dbname=gopay sslmode=disable

# 监听地址
HOST=0.0.0.0

# 监听端口
PORT=8080
